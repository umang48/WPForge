{
    "$schema": "https://schemas.wp.org/trunk/theme.json",
    "version": 2,
    "settings": {
        "appearanceTools": true,
        "layout": {
            "contentSize": "800px",
            "wideSize": "1140px"
        },
        "color": {
            "custom": false,
            "customGradient": false,
            "palette": [
                {
                    "slug": "primary",
                    "color": "#0073aa",
                    "name": "Primary Blue"
                },
                {
                    "slug": "background",
                    "color": "#ffffff",
                    "name": "White"
                },
                {
                    "slug": "surface",
                    "color": "#f9f9f9",
                    "name": "Light Gray Surface"
                },
                {
                    "slug": "text-main",
                    "color": "#333333",
                    "name": "Main Text"
                },
                {
                    "slug": "text-muted",
                    "color": "#666666",
                    "name": "Muted Text"
                }
            ]
        },
        "typography": {
            "customFontSize": false,
            "dropCap": false,
            "fontSizes": [
                {
                    "slug": "small",
                    "size": "0.875rem",
                    "name": "Small"
                },
                {
                    "slug": "normal",
                    "size": "1rem",
                    "name": "Normal"
                },
                {
                    "slug": "large",
                    "size": "1.5rem",
                    "name": "Large"
                },
                {
                    "slug": "huge",
                    "size": "2.25rem",
                    "name": "Huge"
                }
            ]
        },
        "spacing": {
            "blockGap": true,
            "margin": true,
            "padding": true,
            "units": [ "px", "em", "rem", "vh", "vw", "%" ]
        }
    },
    "styles": {
        "color": {
            "background": "var(--wp--preset--color--background)",
            "text": "var(--wp--preset--color--text-main)"
        },
        "typography": {
            "fontSize": "var(--wp--preset--font-size--normal)",
            "fontFamily": "system-ui, -apple-system, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif, 'Apple Color Emoji', 'Segoe UI Emoji', 'Segoe UI Symbol'",
            "lineHeight": "1.6"
        },
        "elements": {
            "link": {
                "color": {
                    "text": "var(--wp--preset--color--primary)"
                }
            },
            "h1": {
                "typography": {
                    "fontSize": "var(--wp--preset--font-size--huge)",
                    "fontWeight": "700"
                }
            },
            "h2": {
                "typography": {
                    "fontSize": "var(--wp--preset--font-size--large)",
                    "fontWeight": "700"
                }
            }
        }
    }
}